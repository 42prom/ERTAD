# Local development only. Run npm run setup to generate unique credentials.
COMPOSE_PROJECT_NAME=ertad
ERTAD_API_PORT=13000
ERTAD_WEB_PORT=15173
ERTAD_POSTGRES_PORT=15432
ERTAD_REDIS_PORT=16379
ERTAD_STORAGE_PORT=19000
# Optional S3 endpoint override for task reports; otherwise uses the loopback storage port.
# ERTAD_EVIDENCE_ENDPOINT=http://127.0.0.1:19000
POSTGRES_DB=ertad
POSTGRES_USER=ertad_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=ertad_local
S3_SECRET_KEY=
# npm run admin:bootstrap generates the encryption key and enables host-only local login.
ERTAD_LOCAL_ADMIN=false
API_KEY_ENCRYPTION_SECRET=
ERTAD_WEB_DEMO=false
# Set to true to start a cloudflared tunnel on npm run dev (requires prior tunnel setup).
ERTAD_TUNNEL=false
ERTAD_TUNNEL_HOST=
ERTAD_TUNNEL_ORIGIN=

# Optional reviewed local tunnel protection; npm run network:setup generates private keys.
ERTAD_NETWORK_CONTROL=false
ERTAD_TUNNEL_INGRESS_PORT=15174
ERTAD_PROXY_SECRET=
ERTAD_NETWORK_IP_KEY=
ERTAD_COUNTRY_HEADERS_VERIFIED=false
