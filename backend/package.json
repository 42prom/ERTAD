    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "cbor-x": "1.6.6",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "csv-parser": "3.2.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "google-auth-library": "11.0.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "nodemailer": "10.4.0",
