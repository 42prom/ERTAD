{
  "name": "@ertad/backend",
  "version": "0.1.0",
  "description": "ERTAD API with the complete ERTAD code baseline awaiting domain adaptation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch ../scripts/dev-api.ts",
    "build": "tsc --noEmit && node ../scripts/build-api.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test tests/foundation.test.ts && npm run test:unit",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js"
  },
  "author": "Mikheili Nakeuri",
  "license": "UNLICENSED",
  "dependencies": {
