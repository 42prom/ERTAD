  },
  "devDependencies": {
    "@types/express": "^5.0.6", "@types/cors": "^2.8.19", "@types/pg": "^8.16.0",
    "@types/node": "^24.0.0", "@types/supertest": "^7.2.1", "supertest": "^7.2.2",
    "tsx": "^4.21.0", "typescript": "^5.9.3"
